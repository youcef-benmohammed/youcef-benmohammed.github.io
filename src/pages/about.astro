---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="About | Youcef BEN MOHAMMED"
  description="Background, experience and skills of Youcef Ben Mohammed, bioinformatics engineer (NGS pipelines and transcriptomics)."
>
  <div class="stack gap-20">
    <main class="wrapper about">
      <Hero
        title="About"
        tagline="Thanks for stopping by. Read below to learn more about myself and my background."
      >
        <!-- <img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Youcef BEN MOHAMMED at work with a colleague"
				/> -->
      </Hero>

      <section>
        <h2 class="section-title">Background</h2>
        <div class="content">
          <p>
            I am a bioinformatics engineer specialised in NGS data analysis and
            transcriptomics. I design and maintain reproducible analysis pipelines
            for short-read and Nanopore long-read sequencing data, run them on
            HPC clusters, and build tools (R Shiny apps, R Markdown reports) that
            make the results usable by biologists.
          </p>
          <p class="open">
            Open to new opportunities in bioinformatics:
            <a href="mailto:youcef.benmohammed@hotmail.com">get in touch</a>.
          </p>
          <p>
            <a class="cv-link" href="/cv/Youcef-Ben-Mohammed-CV-EN.pdf" target="_blank" rel="noopener">Download my CV (PDF, English)</a>
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-title">Experience</h2>
        <div class="content stack gap-8">
          <div>
            <h3>Bioinformatics Engineer (Ingénieur d'études)</h3>
            <p class="meta">IPS2 – Institute of Plant Sciences Paris-Saclay (Université Paris-Saclay, INRAE) · Feb 2025 – present</p>
            <ul>
              <li>Design and maintenance of Snakemake pipelines for RNA-seq analysis (Illumina short reads and Nanopore long reads) on a SLURM HPC cluster.</li>
              <li>Transcript reconstruction, lncRNA identification and coding-potential prediction, differential expression and alternative splicing analyses in plant genomes.</li>
              <li>Integration of large annotation and expression tables with DuckDB/Parquet; reproducible R Markdown reports for biologists.</li>
            </ul>
          </div>
          <div>
            <h3>Master's internship – Bioinformatics</h3>
            <p class="meta">INSERM U1236, Rennes · Jan 2024 – Jun 2024</p>
            <ul>
              <li>Bulk RNA-seq deconvolution with a single-cell reference atlas in follicular lymphoma (BayesPrism, MuSiC), benchmarked on pseudo-bulk simulations. <a href="/work/deconvolution/">Project page</a></li>
            </ul>
          </div>
        </div>
      </section>

      <section>
        <h2 class="section-title">Education</h2>
        <div class="content">
          <p>
            MSc in Bioinformatics &amp; Systems Biology – Université Toulouse III – Paul Sabatier, France (2022–2024)
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-title">Technical skills</h2>
        <div class="content">
          <p>
            <strong>Languages:</strong> R, Python, Bash ·
            <strong>Workflows &amp; HPC:</strong> Snakemake, SLURM, conda, Docker, Git, GitHub Actions ·
            <strong>Analyses:</strong> RNA-seq (DESeq2), long-read transcriptomics, lncRNA, ChIP-seq, scRNA-seq deconvolution ·
            <strong>Data &amp; apps:</strong> DuckDB, Parquet, R Shiny, R Markdown
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-title">Soft skills</h2>
        <div class="content">
          <p>
            Communication with biologists, problem solving, team collaboration, project management.
          </p>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  img {
    margin-top: 1.5rem;
    border-radius: 1.5rem;
    box-shadow: var(--shadow-md);
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  .section-title {
    grid-column-start: 1;
    font-size: var(--text-xl);
    color: var(--gray-0);
  }

  .content {
    grid-column: 2 / 4;
  }

  .content h3 {
    font-size: var(--text-lg);
    color: var(--gray-0);
  }

  .content .meta {
    color: var(--gray-400);
    font-size: var(--text-md);
    margin-bottom: 0.5rem;
  }

  .content ul {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .content li + li {
    margin-top: 0.4rem;
  }

  .content p + p {
    margin-top: 1rem;
  }

  .cv-link {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border-radius: 999rem;
    background: var(--gradient-accent);
    color: var(--accent-text-over);
    font-weight: 600;
    text-decoration: none !important;
  }

  .open {
    font-weight: 600;
    color: var(--gray-0);
  }

  .content :global(a) {
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus) {
    text-decoration-color: currentColor;
  }

  @media (min-width: 50em) {
    .about {
      display: grid;
      grid-template-columns: 1fr 60% 1fr;
    }

    .about > :global(:first-child) {
      grid-column-start: 2;
    }

    section {
      display: contents;
      font-size: var(--text-lg);
    }
  }
</style>
