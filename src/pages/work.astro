---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Hero from "../components/Hero.astro";
import Grid from "../components/Grid.astro";

import { sortProjects } from "../utils/projects";

const all = sortProjects(await getCollection("work"));
const projects = all.filter((p) => p.data.category === "bioinformatics");
const sideProjects = all.filter((p) => p.data.category === "side");
---

<BaseLayout
  title="My Projects | Youcef BEN MOHAMMED"
  description="Learn about Youcef BEN MOHAMMED's most recent projects"
>
  <div class="stack gap-20">
    <main class="wrapper stack gap-8">
      <Hero
        title="My Projects"
        tagline="Bioinformatics projects first, followed by earlier data-science side projects."
        align="start"
      />
      <Grid>
        {
          projects.map((project) => (
            <li>
              <PortfolioPreview project={project} />
            </li>
          ))
        }
      </Grid>
      {
        sideProjects.length > 0 && (
          <>
          <h2 class="subsection">Data science side projects</h2>
          <Grid variant="small">
            {sideProjects.map((project) => (
              <li>
                <PortfolioPreview project={project} />
              </li>
            ))}
          </Grid>
          </>
        )
      }
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .subsection {
    margin-top: 4rem;
    font-size: var(--text-2xl);
    color: var(--gray-0);
  }
</style>
