---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";

// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";

import { sortProjects } from "../utils/projects";

// Content Fetching: four featured bioinformatics projects
const projects = sortProjects(
  (await getCollection("work")).filter((p) => p.data.category === "bioinformatics")
).slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
  <div class="stack gap-20 lg:gap-32">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="hero">
        <Hero
          title="Youcef Ben Mohammed"
          size="md"
          tagline="Bioinformatics engineer specialised in NGS pipelines and transcriptomics. I build reproducible workflows and interactive tools that turn sequencing data into biological answers."
          align="center"
        >
          <a class="cv-link" href="/cv/Youcef-Ben-Mohammed-CV-EN.pdf" target="_blank" rel="noopener">
            Download CV (PDF) <Icon icon="arrow-right" size="1.1em" />
          </a>
        </Hero>

        <picture>
          <source media="(max-width: 49.99em)" srcset="/assets/portrait-avatar.webp" width="480" height="480" />
          <img
            alt="Youcef BEN MOHAMMED"
            width="750"
            height="1000"
            src="/assets/portrait.webp"
          />
        </picture>
      </header>

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-32">
      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Selected Projects</h3>
          <p>Bioinformatics projects, from RNA-seq analysis to interactive applications.</p>
        </header>

        <div class="gallery">
          <Grid>
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            All Projects
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .roles {
    display: none;
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.6rem 1.4rem;
    border-radius: 999rem;
    background: var(--gradient-accent);
    color: var(--accent-text-over);
    font-weight: 600;
    font-size: var(--text-md);
    text-decoration: none;
    align-self: center;
    width: fit-content;
    box-shadow: var(--shadow-sm);
  }

  /* Mobile: compact round portrait above the name */
  .hero picture {
    display: block;
    order: -1;
    margin-inline: auto;
  }

  .hero img {
    width: 11rem;
    height: 11rem;
    margin-inline: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 50%;
    border-radius: 50%;
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 50em) {
    .hero {
      display: grid;
      grid-template-columns: 6fr 4fr;
      padding-inline: 2.5rem;
      gap: 3.75rem;
    }

    .roles {
      margin-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
    }

    .hero picture {
      order: 0;
      margin-inline: 0;
    }

    .hero img {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 4;
      border-radius: 4.5rem;
      object-fit: cover;
      object-position: 50% 30%;
    }
  }

  /* ====================================================== */

  .section {
    display: grid;
    gap: 2rem;
  }

  .with-background {
    position: relative;
  }

  .with-background::before {
    --hero-bg: var(--bg-image-subtle-2);

    content: "";
    position: absolute;
    pointer-events: none;
    left: 50%;
    width: 100vw;
    aspect-ratio: calc(2.25 / var(--bg-scale));
    top: 0;
    transform: translateY(-75%) translateX(-50%);
    background:
      url("/assets/backgrounds/noise.png") top center/220px repeat,
      var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
      var(--gray-999);
    background-blend-mode: overlay, normal, normal, normal;
    mix-blend-mode: var(--bg-blend-mode);
    z-index: -1;
  }

  .with-background.bg-variant::before {
    --hero-bg: var(--bg-image-subtle-1);
  }

  .section-header {
    justify-self: center;
    text-align: center;
    max-width: 50ch;
    font-size: var(--text-md);
    color: var(--gray-300);
  }

  .section-header h3 {
    font-size: var(--text-2xl);
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: "header header header header" "gallery gallery gallery gallery";
      gap: 5rem;
    }

    .section.with-cta {
      grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
    }

    .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    .section-header h3 {
      font-size: var(--text-4xl);
    }

    .with-cta .section-header {
      justify-self: flex-start;
      text-align: left;
    }

    .gallery {
      grid-area: gallery;
    }

    .cta {
      grid-area: cta;
    }
  }

  /* ====================================================== */

  .mention-card {
    display: flex;
    height: 7rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    color: var(--gray-300);
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 50em) {
    .mention-card {
      border-radius: 1.5rem;
      height: 9.5rem;
    }
  }
</style>
